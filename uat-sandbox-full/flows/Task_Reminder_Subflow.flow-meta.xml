    <decisions>
        <name>Check_for_reminder_type</name>
        <label>Check for reminder type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>X60</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>reminderType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>60</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_60Min_Reminder_Emails</targetReference>
            </connector>
            <label>60</label>
        </rules>
        <rules>
            <name>X90</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>reminderType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>90</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_90Min_Reminder_Emails</targetReference>
            </connector>
            <label>90</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Task_is_closed</name>
        <label>Check if Task is closed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Closed</defaultConnectorLabel>
        <rules>
            <name>Not_Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Initial_Contact_Task.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Initial_Contact_Task.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Initial Contact</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Null_and_Active_check_on_the_Owner_and_Manager_record</targetReference>
            </connector>
            <label>Not Closed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Null_and_Active_check_on_the_Owner_and_Manager_record</name>
        <label>Null and Active check on the Owner and Manager record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Active_Not_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Initial_Contact_Task.Owner:User.ManagerId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Initial_Contact_Task.Owner:User.Manager.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Initial_Contact_Task.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Creating_Email_Id_list_of_recipients</targetReference>
            </connector>
            <label>Active &amp; Not Null</label>
        </rules>
    </decisions>
