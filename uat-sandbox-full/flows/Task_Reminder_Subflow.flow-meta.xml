    <formulas>
        <name>Email_Body_template</name>
        <dataType>String</dataType>
        <expression>IF(
  {!reminderType} = &apos;60&apos;,
  &quot;&lt;p&gt;Dear &quot; &amp; {!Get_Lead_related_Task.FirstName} &amp; &quot;,&lt;/p&gt;&lt;p style=&apos;color: #E67E22;&apos;&gt;&lt;strong&gt;This is an urgent reminder!&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;The &lt;strong&gt;&apos;Initial Contact&apos;&lt;/strong&gt; task for Lead: &lt;strong&gt;&quot; &amp; {!Get_Lead_related_Task.FirstName} &amp; &quot; &quot; &amp; {!Get_Lead_related_Task.LastName} &amp; &quot;&lt;/strong&gt; has not been completed within &lt;strong&gt;60 minutes&lt;/strong&gt; of assignment.&lt;/p&gt;&lt;p&gt;Please make immediate contact with the customer and mark the task as complete in the system.&lt;/p&gt;&lt;p&gt;Your prompt attention to this matter is crucial to maintain our response time standards.&lt;/p&gt;&lt;p&gt;Best regards,&lt;br/&gt;Phoenix Residential Notifications&lt;/p&gt;&quot;,
  
  &quot;&lt;p&gt;Dear &quot; &amp; {!Get_Lead_related_Task.FirstName} &amp; &quot; and Leadership Team,&lt;/p&gt;&lt;p style=&apos;color: #C0392B;&apos;&gt;&lt;strong&gt;This is a critical and final reminder!&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;The &lt;strong&gt;&apos;Initial Contact&apos;&lt;/strong&gt; task for Lead: &lt;strong&gt;&quot; &amp; {!Get_Lead_related_Task.FirstName} &amp; &quot; &quot; &amp; {!Get_Lead_related_Task.LastName} &amp; &quot;&lt;/strong&gt; has &lt;u&gt;still not been completed 90 minutes after assignment&lt;/u&gt;, despite previous notifications.&lt;/p&gt;&lt;p&gt;Immediate action is required to contact the customer and mark this task as complete. This ongoing delay directly impacts our response time metrics.&lt;/p&gt;&lt;p style=&apos;color: #C0392B;&apos;&gt;&lt;strong&gt;If this task is not resolved immediately, further internal escalation will occur.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Best regards,&lt;br/&gt;Phoenix Residential Notifications&lt;/p&gt;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>notification_body_template</name>
        <dataType>String</dataType>
        <expression>IF(
  {!reminderType} = &apos;60&apos;,
  &quot;The &apos;Initial Contact&apos; task for Lead &quot; &amp; {!Get_Lead_related_Task.FirstName} &amp; &quot; &quot; &amp; {!Get_Lead_related_Task.LastName} &amp; &quot; has not been completed within 60 minutes of assignment. Immediate follow-up is required to meet response time standards.&quot;,
  &quot;The &apos;Initial Contact&apos; task for Lead &quot; &amp; {!Get_Lead_related_Task.FirstName} &amp; &quot; &quot; &amp; {!Get_Lead_related_Task.LastName} &amp; &quot; remains incomplete 90 minutes after assignment, despite previous reminders. Immediate action is mandatory — internal escalation will follow if unresolved.&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Subject_Template</name>
        <dataType>String</dataType>
        <expression>IF({!reminderType}==&apos;60&apos;, 
&apos;ACTION REQUIRED: Initial Contact Overdue for Lead: Get_Lead_related_Task.FirstName Get_Lead_related_Task.LastName&apos;, 
&apos;FINAL URGENT: Lead Get_Lead_related_Task.FirstName Get_Lead_related_Task.LastName - Initial Contact STILL Not Made (90 Mins)&apos;)</expression>
    </formulas>
    <formulas>
        <name>title_template</name>
        <dataType>String</dataType>
        <expression>IF(
  {!reminderType} = &apos;60&apos;,
  &quot;⚠️ Urgent: Initial Contact Pending&quot;,
  &quot;🚨 Critical: Final Reminder for Initial Contact&quot;
)</expression>
    </formulas>
