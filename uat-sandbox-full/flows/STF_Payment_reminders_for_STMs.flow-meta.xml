    <description>Scheduled flow to send reminders to STMs, 15 days before the payment due date and also to send reminders on tasks which missed due date and to create follow-up tasks (Changes made to the Task Subject formula variable to not exceed the content to more than 255 characters)</description>
    <environments>Default</environments>
    <formulas>
        <name>emailBody</name>
        <dataType>String</dataType>
        <expression>&quot;Dear &quot; &amp;
{!Loop_Through_Booking_Payment_Schedules.Booking__r.Owner:User.FirstName} &amp; &quot;, &quot; &amp; BR() &amp; BR()&amp;
&quot;This is a reminder to follow up with your assigned customer regarding an upcoming payment due in 15 days.&quot; &amp; BR() &amp;
&quot;Payment Details:&quot; &amp; BR() &amp;
&quot;Customer Name: &quot; &amp; {!Loop_Through_Booking_Payment_Schedules.Booking__r.Account_Id__r.Name} &amp; BR() &amp;
&quot;Unit: &quot; &amp; {!Loop_Through_Booking_Payment_Schedules.Booking__r.Unit_Id__r.Name} &amp; BR() &amp;
&quot;Payment Amount: &quot; &amp; TEXT({!Loop_Through_Booking_Payment_Schedules.Installment_Amount__c}) &amp; BR() &amp;
&quot;Scheduled Payment Date: &quot; &amp; TEXT({!Loop_Through_Booking_Payment_Schedules.Payment_Due_Date__c}) &amp; BR() &amp;
BR() &amp;
&quot;Action Required:&quot; &amp; BR() &amp;
&quot;Contact the customer to remind them about the upcoming payment.&quot; &amp; BR() &amp;
&quot;Log your follow-up actions in the system.&quot; &amp; BR() &amp;
&quot;Your timely follow-up is important to ensure smooth collections and avoid delays.&quot; &amp; BR() &amp;
&quot;Thank you for your prompt attention.&quot; &amp; BR() &amp; BR()&amp;
&quot;Best regards,&quot; &amp; BR() &amp;
&quot;Phoenix Residential Notifications&quot;</expression>
    </formulas>
    <formulas>
        <name>overdueTask_description</name>
        <dataType>String</dataType>
        <expression>&apos;This task was created because the original task &quot;&apos; &amp; {!Loop_Through_Tasks.Subject} &amp; &apos;&quot; (Due: &apos; &amp; TEXT({!Loop_Through_Tasks.ActivityDate}) &amp; &apos;) was overdue and incomplete. Please follow up with the customer.&apos;</expression>
    </formulas>
    <formulas>
        <name>overdueTask_subject</name>
        <dataType>String</dataType>
        <expression>LEFT(
    IF(
        CONTAINS({!Loop_Through_Tasks.Subject}, &quot;Follow Up: Overdue Task for &quot;),
        {!Loop_Through_Tasks.Subject},
        &quot;Follow Up: Overdue Task for &quot; &amp; {!Loop_Through_Tasks.Subject}
    ),
    255
)</expression>
    </formulas>
    <formulas>
        <name>reminderTriggerDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 15</expression>
    </formulas>
    <formulas>
        <name>subjectEmail</name>
        <dataType>String</dataType>
        <expression>&quot;Reminder: Payment Due in 15 Days –  &quot; &amp; {!Loop_Through_Booking_Payment_Schedules.Booking__r.Account_Id__r.Name}</expression>
    </formulas>
    <formulas>
        <name>tomorrow</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 1</expression>
    </formulas>
    <formulas>
        <name>yesterday</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 1</expression>
    </formulas>
