<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <decisions>
        <name>Amount_Paid_Check</name>
        <label>Amount Paid Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Amount_Paid_is_greater_than_installment_amount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount_Paid__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>$Record.Installment_Amount__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Booking__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Payment_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Paid</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Payment_Receipt</targetReference>
            </connector>
            <label>Amount Paid is greater than installment amount</label>
        </rules>
        <rules>
            <name>Installment_Amount_Paid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Payment_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Paid</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Create_Payment_Receipt</targetReference>
            </connector>
            <label>Installment Amount Paid</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_Next_Booking_payment_schedule_record_exists</name>
        <label>Check for Next Booking payment schedule record exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Next_BPS_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Remaining_Booking_Payment_Schedules</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_next_BPS_record</targetReference>
            </connector>
            <label>Next BPS Exists</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>This formula means the extra amount paid by the customer in previous installment is deducted in next installment.</description>
        <name>DeductingExtraAmountFromNextBPS</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Remaining_Booking_Payment_Schedules.Installment_Amount__c} - {!ExtraAmountPaid}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ExtraAmountPaid</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Amount_Paid__c} - {!$Record.Installment_Amount__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>RTF : Booking Payment Schedule After Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF : Booking Payment Schedule After Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
