    <recordCreates>
        <name>Create_Payment_Receipt</name>
        <label>Create Payment Receipt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Remaining_Booking_Payment_Schedules</targetReference>
        </connector>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>$Record.Booking__r.Account_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Amount_Paid__c</field>
            <value>
                <elementReference>$Record.Amount_Paid__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Booking_Payment_Schedule__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Date_Of_Payment__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Mode_Of_Payment__c</field>
            <value>
                <elementReference>$Record.Mode_Of_Payment__c</elementReference>
            </value>
        </inputAssignments>
        <object>Payment_Receipt__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Remaining_Booking_Payment_Schedules</name>
        <label>Get Remaining Booking Payment Schedules</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_for_Next_Booking_payment_schedule_record_exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Booking__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Booking__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Installment_Number__c</field>
            <operator>GreaterThan</operator>
            <value>
                <elementReference>$Record.Installment_Number__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Booking_Payment_Schedule__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>this element will be updating next installment amount by deducting the extra amount which customer has paid in current installment.</description>
        <name>update_next_BPS_record</name>
        <label>update next BPS record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Remaining_Booking_Payment_Schedules.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Installment_Number__c</field>
            <operator>GreaterThan</operator>
            <value>
                <elementReference>$Record.Installment_Number__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Adjusted_Amount__c</field>
            <value>
                <elementReference>DeductingExtraAmountFromNextBPS</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description__c</field>
            <value>
                <elementReference>PaymentDescriptionInCaseOfAdjustments</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Show_Description__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Booking_Payment_Schedule__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Amount_Paid_Check</targetReference>
        </connector>
        <object>Booking_Payment_Schedule__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>PaymentDescriptionInCaseOfAdjustments</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;strong&gt;This installment amount has been adjusted.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;An extra amount paid in a previous installment has been applied here.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;Previous Installment Number:&lt;/strong&gt; {!$Record.Installment_Number__c}&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Previous Installment Amount:&lt;/strong&gt; &lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;₹&lt;/span&gt;{!$Record.Installment_Amount__c}&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Amount Paid Previously:&lt;/strong&gt; ₹&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!$Record.Amount_Paid__c}&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Current Installment Amount (Before Adjustment): &lt;/strong&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;₹{!Get_Remaining_Booking_Payment_Schedules.Installment_Amount__c}&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Current Installment Amount (After Adjustment):&lt;/strong&gt; &lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!DeductingExtraAmountFromNextBPS}&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Please note that the overpaid amount from the previous installment has been &lt;strong&gt;deducted from the current installment.&lt;/strong&gt;&lt;/p&gt;</text>
    </textTemplates>
</Flow>
