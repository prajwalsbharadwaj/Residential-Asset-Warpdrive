        <rules>
            <name>Residential_Record_Type</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Residential</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Approved_Status</targetReference>
            </connector>
            <label>Residential Record Type</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Waiver_Amount</name>
        <label>Check Waiver Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Demand_Records_with_Partial_Discount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Partial Discount</defaultConnectorLabel>
        <rules>
            <name>Full_Discount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Waiver_Amount__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_Through_All_Demand_Records.Calculated_Interest__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Demand_Records_with_Full_Discount</targetReference>
            </connector>
            <label>Full Discount</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CalculatedInterestAmount</name>
        <dataType>Currency</dataType>
        <expression>ABS($Record.Waiver_Amount__c - Loop_Through_All_Demand_Records.Calculated_Interest__c)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>RTF : Interest Wavier Update Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF : Interest Wavier Update Before Save</label>
