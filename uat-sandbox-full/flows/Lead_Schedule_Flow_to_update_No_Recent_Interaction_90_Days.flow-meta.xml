<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <decisions>
        <name>Check_Site_Visit_Scheduled</name>
        <label>Check Site Visit Scheduled</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Visit_Not_Scheduled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Site_Visit_Scheduled__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Country</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_triggering_lead</targetReference>
            </connector>
            <label>Visit Not Scheduled</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>SiteVisitPast90DaysCreatedDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.CreatedDate} - 90</expression>
    </formulas>
    <interviewLabel>Lead : Schedule Flow to update No Recent Interaction 90 Days {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead : Schedule Flow to update No Recent Interaction 90 Days</label>
    <processMetadataValues>
