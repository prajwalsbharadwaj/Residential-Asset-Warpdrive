    <customErrors>
        <name>Invalid_Payment_Plan</name>
        <label>Invalid Payment Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Selected Payment plan has no Payment Schedules please select a valid Payment Plan.</errorMessage>
            <fieldSelection>Payment_Plan_Id__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_Payment_Schedules_Exists</name>
        <label>Check Payment Schedules Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Invalid_Payment_Plan</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Payment_Schedule_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Payment_Schedules</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_on_Payment_schedules</targetReference>
            </connector>
            <label>Payment Schedule Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Checks_on_Booking</name>
        <label>Checks on Booking</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Amount_isPresent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Final_Amount__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Payment_Plan_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Residential_Sales_Booking</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Payment_Schedules</targetReference>
            </connector>
            <label>Amount isPresent</label>
        </rules>
    </decisions>
    <decisions>
        <name>Days_Or_Month</name>
        <label>Days Or Month</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_on_Payment_schedules</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Month_Number_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_on_Payment_schedules.Month_Number__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_on_Payment_schedules.Due_In_Days__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Booking_payment_Schedule_based_on_month_number</targetReference>
            </connector>
            <label>Month Number Exists</label>
        </rules>
        <rules>
            <name>Due_Days_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_on_Payment_schedules.Due_In_Days__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_on_Payment_schedules.Month_Number__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Booking_payment_Schedule_based_on_Due_Days</targetReference>
            </connector>
            <label>Due Days Exists</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>InstallmentAmount</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Final_Amount__c} * ({!Loop_on_Payment_schedules.Payment_Percentage__c}/100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>InstallmentNumberFormula</name>
        <dataType>Number</dataType>
        <expression>{!InstallmentVariable} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>PaymentDueDatePlusMonths</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Record.Booking_Date__c},{!Loop_on_Payment_schedules.Month_Number__c})</expression>
    </formulas>
    <formulas>
        <name>PaymentDueDaysPlusDays</name>
        <dataType>Date</dataType>
        <expression>DATE(
  YEAR({!$Record.Booking_Date__c}),
  MONTH({!$Record.Booking_Date__c}),
  DAY({!$Record.Booking_Date__c})
) + {!Loop_on_Payment_schedules.Due_In_Days__c}</expression>
    </formulas>
    <interviewLabel>Booking Payment Schedule : Create Booking Payment Schedule while creating Bookings based on payment plan. {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Booking Payment Schedule : Create Booking Payment Schedule while creating Bookings based on payment plan.</label>
    <loops>
        <name>Loop_on_Payment_schedules</name>
        <label>Loop on Payment schedules</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Payment_Schedules</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Days_Or_Month</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Insert_Booking_Payment_Schedules</targetReference>
        </noMoreValuesConnector>
    </loops>
