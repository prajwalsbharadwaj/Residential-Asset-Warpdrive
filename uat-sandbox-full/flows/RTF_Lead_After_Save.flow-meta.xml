    <textTemplates>
        <name>formattedEmailBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;html&gt;
  &lt;body style=&quot;font-family: Arial, sans-serif; font-size: 15px; color: #333333; line-height: 1.6; background-color: #f9f9f9; padding: 25px;&quot;&gt;

    &lt;div style=&quot;max-width: 600px; margin: 0 auto; background-color: #ffffff; padding: 25px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.07); border: 1px solid #e0e0e0;&quot;&gt;

      &lt;div style=&quot;background-color: #EBF5FB; padding: 20px; text-align: center; border-radius: 6px; border: 1px solid #D6EAF8; margin-bottom: 25px;&quot;&gt;
        &lt;h2 style=&quot;color: #2E86C1; font-size: 22px; margin: 0;&quot;&gt;New Task Assigned 📌&lt;/h2&gt;
      &lt;/div&gt;

      &lt;p style=&quot;font-size: 16px; margin-bottom: 20px;&quot;&gt;
        Dear &lt;strong&gt;{!$Record.Owner:User.FirstName} {!$Record.Owner:User.LastName}&lt;/strong&gt;,
      &lt;/p&gt;

      &lt;p style=&quot;font-size: 15px; margin-bottom: 20px;&quot;&gt;
        A new task titled &lt;strong&gt;&quot;Initial Contact&quot;&lt;/strong&gt; has been assigned to you for the following Lead:
      &lt;/p&gt;

      &lt;div style=&quot;background-color: #FCF3CF; padding: 15px; border: 1px solid #F9E79F; border-radius: 6px; margin: 25px 0;&quot;&gt;
        &lt;h3 style=&quot;color: #B9770E; margin-top: 0;&quot;&gt;Lead Details 📝&lt;/h3&gt;
        &lt;ul style=&quot;padding-left: 20px; margin: 0;&quot;&gt;
          &lt;li&gt;&lt;strong&gt;Name:&lt;/strong&gt; {!$Record.FirstName} {!$Record.LastName}&lt;/li&gt;
          &lt;li&gt;&lt;strong&gt;Email:&lt;/strong&gt; &lt;a href=&quot;mailto:{!$Record.Email}&quot; style=&quot;color: #2E86C1;&quot;&gt;{!$Record.Email}&lt;/a&gt;&lt;/li&gt;
          &lt;li&gt;&lt;strong&gt;Phone:&lt;/strong&gt; &lt;a href=&quot;tel:{!$Record.Phone}&quot; style=&quot;color: #2E86C1;&quot;&gt;{!$Record.Phone}&lt;/a&gt;&lt;/li&gt;
        &lt;/ul&gt;
      &lt;/div&gt;

      &lt;p style=&quot;font-size: 15px; margin-bottom: 20px;&quot;&gt;
        Please ensure that this task is completed within &lt;strong&gt;60 minutes&lt;/strong&gt; to maintain timely engagement with the prospect.
      &lt;/p&gt;

      &lt;div style=&quot;background-color: #F9EBEA; padding: 15px; border: 1px solid #F5B7B1; border-radius: 6px; margin: 25px 0;&quot;&gt;
        &lt;p style=&quot;margin: 0; font-size: 14px; color: #922B21;&quot;&gt;
          ⏰ &lt;strong&gt;Your prompt response is crucial!&lt;/strong&gt; Kindly act immediately.
        &lt;/p&gt;
      &lt;/div&gt;

      &lt;h3 style=&quot;color: #2E86C1;&quot;&gt;Need Assistance?&lt;/h3&gt;
      &lt;p style=&quot;font-size: 14px;&quot;&gt;
        If you have any questions or require support, feel free to reach out to your manager or CRM administrator.
      &lt;/p&gt;

      &lt;p style=&quot;font-size: 14px; margin-top: 30px;&quot;&gt;
        Thank you,&lt;br/&gt;
        &lt;strong&gt;Phoenix Residential Notifications&lt;/strong&gt;
      &lt;/p&gt;

    &lt;/div&gt;

  &lt;/body&gt;
&lt;/html&gt;</text>
