    <decisions>
        <name>Check_Status_and_Allotment_Letter_Sent_Date</name>
        <label>Check Status and Allotment Letter Sent Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_Allotment_Letter_Shared_and_Allotment_Letter_Date_is_NOT_NULL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Allotment Letter Shared</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Allotment_Letter_Sent_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
