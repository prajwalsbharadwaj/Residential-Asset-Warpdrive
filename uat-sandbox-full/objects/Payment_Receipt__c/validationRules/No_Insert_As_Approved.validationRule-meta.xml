<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_Insert_As_Approved</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISNEW(),
  ISPICKVAL(Approval_Status__c, &quot;Approved&quot;)
)</errorConditionFormula>
    <errorDisplayField>Approval_Status__c</errorDisplayField>
    <errorMessage>A new receipt can’t be created as Approved. Submit for approval first.</errorMessage>
</ValidationRule>
