<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_Negative_Amounts</fullName>
    <active>true</active>
    <description>Basic hygiene; avoids accidental negative</description>
    <errorConditionFormula>OR(
  Principal_Applied__c &lt; 0,
  Interest_Applied__c &lt; 0,
  Tax_on_Interest__c &lt; 0,
  Amount_Paid__c &lt;= 0
)</errorConditionFormula>
    <errorMessage>Amounts must be positive.</errorMessage>
</ValidationRule>
