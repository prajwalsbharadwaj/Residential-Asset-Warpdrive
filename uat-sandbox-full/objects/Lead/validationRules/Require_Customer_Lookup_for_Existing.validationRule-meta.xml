<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Customer_Lookup_for_Existing</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Standard_Lead_Residential&quot;,
    ISPICKVAL(LeadSource, &quot;Existing Customer&quot;),
    ISBLANK(Existing_Customer__c)
)</errorConditionFormula>
    <errorDisplayField>Existing_Customer__c</errorDisplayField>
    <errorMessage>Please select a Customer from the lookup field for an Existing Customer lead source</errorMessage>
</ValidationRule>
