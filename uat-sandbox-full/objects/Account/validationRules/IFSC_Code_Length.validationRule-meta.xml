<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IFSC_Code_Length</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(IFSC_Code__c)),
    LEN(IFSC_Code__c) &gt;=10,
				LEN(IFSC_Code__c) &lt;=11 
)</errorConditionFormula>
    <errorDisplayField>IFSC_Code__c</errorDisplayField>
    <errorMessage>IFSC Code should either of 10 or 11 characters</errorMessage>
</ValidationRule>
