<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Primary Assignment Rules</fullName>
        <active>false</active>
        <ruleEntry>
            <formula>NOT(ISNEW())</formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>SDO_Sales_West_Leads</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.State</field>
                <operation>equals</operation>
                <value>CA</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>SDO_Sales_General_Lead</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.LeadSource</field>
                <operation>equals</operation>
                <value>Website</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>SDO_Sales_General_Lead</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Email</field>
                <operation>notEqual</operation>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
    <assignmentRule>
        <fullName>Project Based Assignment</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>Bangalore_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Projects__c</field>
                <operation>equals</operation>
                <value>Varthur Vista,Yalahanka Yard</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.RecordTypeId</field>
                <operation>equals</operation>
                <value>Residential</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Hyderabad_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Projects__c</field>
                <operation>equals</operation>
                <value>Miyapur Manor,Banjara Beam</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.RecordTypeId</field>
                <operation>equals</operation>
                <value>Residential</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Delhi_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Projects__c</field>
                <operation>equals</operation>
                <value>Saket Square,Rohini Rise</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.RecordTypeId</field>
                <operation>equals</operation>
                <value>Residential</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <criteriaItems>
                <field>Lead.RecordTypeId</field>
                <operation>equals</operation>
                <value>Residential</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
