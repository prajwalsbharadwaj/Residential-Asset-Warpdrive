<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Interest_Start_Date__c</fullName>
    <externalId>false</externalId>
    <formula>IF( TODAY() &gt;=   Payment_Due_Date__c ,
			Payment_Due_Date__c + Grace_Period_Days__c + 1  
			, null)</formula>
    <inlineHelpText>Payment Due Date + Grace Period</inlineHelpText>
    <label>Interest Start Date</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Date</type>
</CustomField>
