<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Cancelling_Completed_Visit</fullName>
    <active>true</active>
    <description>Prevents changing a completed site visit to Cancelled.</description>
    <errorConditionFormula>AND(
    ISPICKVAL(PRIORVALUE(Status__c), &quot;Completed&quot;),
    ISPICKVAL(Status__c, &quot;Cancelled&quot;)
)</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>A completed site visit cannot be cancelled.</errorMessage>
</ValidationRule>
