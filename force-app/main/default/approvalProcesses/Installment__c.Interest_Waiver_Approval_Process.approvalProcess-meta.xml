<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Booking__c</field>
        <field>Payment_Milestone__c</field>
        <field>Amount__c</field>
        <field>Overdue_Interest__c</field>
        <field>Days_Overdue__c</field>
        <field>Waived_Interest_Amount__c</field>
        <field>Waiver_Reason__c</field>
        <field>Waiver_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>prajwalsfd@gmail.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Installment__c.Waiver_Status__c</field>
                <operation>equals</operation>
                <value>Requested</value>
            </criteriaItems>
        </entryCriteria>
        <label>Finance Head Review</label>
        <name>Finance_Head_Review</name>
    </approvalStep>
    <description>Formal approval workflow for Sales/CRM teams to request partial or full waiver of overdue simple interest on late installments</description>
    <entryCriteria>
        <criteriaItems>
            <field>Installment__c.Waiver_Status__c</field>
            <operation>equals</operation>
            <value>Requested</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Set_Waiver_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Interest_Waived_True</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Set_Waiver_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Set_Waiver_Requested</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Interest Waiver Approval Process</label>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
